# ==========================================
# Terraform & Infrastructure as Code (IaC)
# ==========================================
# Local .terraform directories (contains downloaded providers and modules)
**/.terraform/

# Terraform state files (crucial to ignore as they contain secrets and system states)
*.tfstate
*.tfstate.*
terraform.tfstate*

# Crash log files
crash.log
crash.*.log

# Terraform variables files (often contain passwords/secrets)
*.tfvars
*.tfvars.json

# Override files (local developer configurations)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
