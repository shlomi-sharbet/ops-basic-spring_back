# ==========================================
target/
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ==========================================
# IDEs and Editors Configuration
# ==========================================
# IntelliJ IDEA
.idea/
*.iml
*.iws
out/

# Eclipse
.metadata/
.classpath
.project
.settings/
*.launch
bin/

# VS Code
.vscode/

# OS-specific files
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
